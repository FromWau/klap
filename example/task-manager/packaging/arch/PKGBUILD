# Maintainer: FromWau <tobias.frommhund@aon.at>
#
# Reference PKGBUILD for shipping a klap CLI on Arch. It packages `klapExample`, the example in this
# repo, straight from a working checkout, so it builds your current tree (committed or not). The
# binary is a self-contained Kotlin/Native executable, so the package needs no JVM or other runtime.
#
# Building it needs, on the build machine rather than as pacman deps: a JDK for Gradle, and a
# populated Gradle dependency cache or network access. Override the checkout path with
# `KLAP_REPO=/path/to/klap makepkg`. Do NOT run another Gradle build in the same tree while makepkg
# runs — they share build/ directories.

_repo="${KLAP_REPO:-$HOME/Projects/klap}"

_klap_version() {
    sed -n 's/^klapVersion *= *"\(.*\)"/\1/p' "$_repo/gradle/libs.versions.toml"
}

pkgname=klap-example
pkgver=$(_klap_version)
pkgrel=1
pkgdesc="klap example CLI: a tiny file-backed task manager (self-contained native binary)"
arch=('x86_64')
url="https://github.com/FromWau/klap"
license=('Apache-2.0')
makedepends=('jdk-openjdk')
depends=('glibc')
optdepends=('bash-completion: tab completion for bash')
# Stripping a Kotlin/Native binary corrupts it.
options=('!strip')

_bin="$_repo/example/task-manager/build/bin/linuxX64/releaseExecutable/klapExample.kexe"

build() {
    cd "$_repo"
    ./gradlew --no-daemon :example:task-manager:linkReleaseExecutableLinuxX64
}

package() {
    install -Dm755 "$_bin" "$pkgdir/usr/bin/klapExample"

    # Completions and the man page are generated by the binary just built, from its own command tree,
    # so they cannot drift from the shipped CLI. Both subcommands are pure stdout — they read no
    # HOME/XDG and write nothing — so they are safe to run inside a clean build chroot.
    "$_bin" completion bash |
        install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/klapExample"
    "$_bin" completion zsh |
        install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_klapExample"
    "$_bin" completion fish |
        install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/klapExample.fish"

    "$_bin" docs man |
        install -Dm644 /dev/stdin "$pkgdir/usr/share/man/man1/klapExample.1"

    install -Dm644 "$_repo/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
